# Copy to `demo/.env.demo` (gitignored) and fill in. run-demo.sh sources it.
#
#   cp demo/.env.demo.example demo/.env.demo && $EDITOR demo/.env.demo
#
# Anything already exported in your shell takes precedence over this file.

# Gemini key from https://aistudio.google.com/api-keys
# NOTE the variable name: ZeroClaw does NOT read $GEMINI_API_KEY. Its env
# grammar is ZEROCLAW_ + the dotted config path with `.` replaced by `__`.
#ZEROCLAW_providers__models__gemini__default__api_key=

# Optional. Defaults to the public mainnet endpoint, which is rate-limited and
# can throttle mid-recording. Set your own here if the rehearsal flakes.
#SOLANA_RPC_URL=

# Optional. Path to the plugin-enabled host you built from source.
#ZEROCLAW_BIN=/home/greyat_labs/Development/zeroclaw-host/target/release/zeroclaw
