    sol-durable-nonce: 368 bytes, sha256 5fec8ba6d9810a412b1e37a7aa42a6cfd9f53d069d8085d0b788b9ceaff72ccf
    sol-fresh-blockhash: 215 bytes, sha256 ac0889d0cd553354c603cb94bdc4a669e6a2e77b0cd57dca2346fda7d69f2c98
