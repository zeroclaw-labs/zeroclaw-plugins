{
  "note": [
    "Scenarios for the offline end-to-end run. Every args object below is exactly",
    "what the ZeroClaw host passes to the component's execute(), including the",
    "host-injected __config the caller cannot spoof. {{RPC_URL}} is replaced with",
    "the local fake's loopback https endpoint at run time.",
    "expect: accept means the component returned a result, refuse means it said no.",
    "rpc_calls is the number of round trips the component made, so a refusal that",
    "never touched the network is visible as 0."
  ],
  "addresses": {
    "sender": "9B5XszUGdMaxCZ7uSQhPzdks5ZQSmWxrmzCSvtJ6Ns6g",
